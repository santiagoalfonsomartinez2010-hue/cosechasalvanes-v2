# Variables de entorno de la web de Cosecha de Salvanés.
# NO pongas aquí claves reales: este archivo es solo una plantilla y está en GitHub.
# Las claves de verdad se escriben en Vercel: Project → Settings → Environment Variables.

# --- Pago con tarjeta (Stripe) ---------------------------------------------------------
# Clave secreta de PRUEBA de Stripe (empieza por sk_test_). Sin ella la web funciona,
# pero el carrito avisa de que el pago de prueba no está activado.
STRIPE_SECRET_KEY=

# Seguro contra cobros reales: aunque pongas una clave real (sk_live_), la web no cobra
# hasta que esta variable valga «si». Déjala vacía hasta revisar los textos legales.
STRIPE_PERMITIR_PAGOS_REALES=

# --- Dominio propio ---------------------------------------------------------------------
# Dirección definitiva de la web, sin barra final (p. ej. https://www.cosechadesalvanes.es).
# Mientras esté vacía, la web pide a Google que no la indexe (es la versión de pruebas).
NEXT_PUBLIC_SITE_URL=
